{
  "name": "paper30min",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && tsc -p tsconfig.node.json && vite build",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/start.mjs",
    "test": "npm run build && node scripts/test.mjs",
    "test:fast": "playwright test --config=playwright.fast.config.ts",
    "test:desktop": "npm run build && npm run test:electron",
    "test:electron": "playwright test --config=playwright.electron.config.ts",
    "test:dead-code": "knip --no-progress",
    "format": "cd .. && oxfmt --write .",
    "format:check": "cd .. && oxfmt --check .",
    "check:fast": "npm run typecheck && npm run test:dead-code && npm run check:lint && npm run check:secrets && node scripts/floor-guard.mjs",
    "check:task": "npm run check:fast && npm run check:architecture && npm run check:lint:type-aware && node scripts/test.mjs -g \"project-core|document-core|arxiv-import|pdf-import|pdf-reparse|pdf-snapshot|pdf-verification\"",
    "check:full": "npm run check:fast && npm run check:architecture && npm run check:lint:type-aware && npm run check:dependencies && npm run build && node scripts/test.mjs",
    "check:secrets": "gitleaks dir .. --redact --no-banner --config ../.gitleaks.toml",
    "check:lint": "node scripts/check-lint.mjs",
    "check:lint:type-aware": "node scripts/check-lint.mjs --type-aware",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@embedpdf/core": "2.15.1",
    "@embedpdf/engines": "2.15.1",
    "@embedpdf/models": "2.15.1",
    "@embedpdf/pdfium": "2.15.1",
    "@embedpdf/plugin-document-manager": "2.15.1",
    "@embedpdf/plugin-rotate": "2.15.1",
    "@embedpdf/plugin-scroll": "2.15.1",
    "@embedpdf/plugin-spread": "2.15.1",
    "@embedpdf/plugin-viewport": "2.15.1",
    "@embedpdf/plugin-zoom": "2.15.1",
    "@embedpdf/react-pdf-viewer": "2.15.1",
    "@vscode/markdown-it-katex": "1.1.2",
    "codemirror": "6.0.2",
    "katex": "0.16.47",
    "lucide-react": "1.55.0",
    "markdown-it": "15.0.3",
    "mdast-util-from-markdown": "2.1.0",
    "parse5": "^7.3.0",
    "pngjs": "7.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typebox": "1.3.27",
    "undici": "7.30.1"
  },
  "overrides": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-codemode": "1.1.0",
    "@earendil-works/pi-coding-agent": {
      ".": "1.1.0",
      "undici": "8.12.2"
    },
    "@earendil-works/pi-mcp": "1.1.0",
    "@earendil-works/pi-telemetry": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@swc/core": "1.16.22",
    "@types/node": "24.10.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "dependency-cruiser": "18.8.0",
    "electron": "44.9.1",
    "knip": "6.45.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "tsrs": "7.1.0-beta.tsrs4",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
