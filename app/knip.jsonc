{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "entry": [
    "src/main/main.ts",
    "src/main/worker.ts",
    "src/main/preload.cts",
    "src/renderer/main.tsx",
    "scripts/quality-gate.mjs"
  ],
  "project": [
    "src/**/*.{ts,tsx,cts}",
    "tests/**/*.ts",
    "scripts/**/*.mjs",
    "*.ts"
  ],
  "includeEntryExports": true,
  // 外部安全工具由开发机或 CI 安装，不是 npm 依赖。
  "ignoreBinaries": ["gitleaks"],
  // dependency-cruiser 按 parser: "swc" 动态加载，静态引用图看不到。
  "ignoreDependencies": ["@swc/core"],
  // Phase 0 临时豁免已全部移除：contracts.ts 随 Phase 1 契约收敛、arxiv.ts 随
  // vx0.4/vx0.5、parsing.ts 随 Phase 3 旧解析路径退役（s08.6）清理。
  // 死文件、死导出、死类型、依赖和文件类型均正常检查，不再保留类型豁免。
  "treatConfigHintsAsErrors": true
}
