{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paper30Min",
  "version": "1.2.0-beta.1",
  "identifier": "com.paper30min.reader",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Paper30Min",
        "width": 1100,
        "height": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "./windows/installer.nsi"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzMTFBRDM5NDg3RUE2MTgKUldRWXBuNUlPYTBSczlUZktFbGJXT3dpVHlRSnRhd0hscTZlalphQ1NQdUxYNkdGcE91Vyt0eXIK",
      "endpoints": ["https://github.com/attackingjensen/paper-30min/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
